{
  "name": "storefront",
  "version": "0.1.0",
  "private": true,
  "description": "Next.js storefront cho khach hang",
  "scripts": {
    "//scripts": "Chi `dev` boc qua dotenv (tien khi lam o may). `build`/`start` khong boc: tren production khong co file .env, bien do nen tang tiem vao, va dotenv-cli se loi vi thieu file.",
    "dev": "dotenv -e ../../.env -- next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest --config jest.config.ts"
  },
  "dependencies": {
    "@ecommerce/auth-db": "workspace:*",
    "@ecommerce/types": "workspace:*",
    "bcryptjs": "^3.0.3",
    "next": "^14.2.20",
    "next-auth": "5.0.0-beta.32",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@ecommerce/config": "workspace:*",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.6.4",
    "@types/bcryptjs": "^3.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.4.49",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.17",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2"
  }
}
