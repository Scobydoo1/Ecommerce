generator client {
  provider        = "prisma-client-js"
  output          = "../generated/prisma"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("AUTH_DATABASE_URL")
  schemas  = ["auth"]
}

/// Tai khoan khach hang. Chi luu ban bam bcrypt, khong bao gio luu mat khau.
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String?
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@schema("auth")
}
